{
  "name": "churches.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --env-file-if-exists=.env.local node_modules/@angular/cli/bin/ng.js serve",
    "build": "ng build",
    "serve:ssr": "node --env-file-if-exists=.env.local --import ./instrumentation.mjs dist/churches.client/server/server.mjs",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:utilities": "check-design-utilities",
    "test": "ng test",
    "test:coverage": "vitest run --coverage",
    "build:ci": "ng build --configuration=ci",
    "bddgen": "bddgen",
    "e2e": "npm run build:ci && bddgen && playwright test --project=integration --project=e2e --max-failures=1",
    "e2e:synthetic": "playwright test --project=synthetic",
    "typecheck:e2e": "bddgen && tsc -p tsconfig.e2e.json",
    "typecheck:spec": "tsc -p tsconfig.spec.json --noEmit",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "^24.15.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "connect-redis": "^10.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "leaflet": "^1.9.4",
    "openid-client": "^6.8.8",
    "pino": "^10.3.1",
    "pino-elasticsearch": "^9.0.0",
    "redis": "^6.2.1",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/schematics": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@crgolden/modules": "0.16.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-istanbul": "^5.0.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "jsdom": "^30.1.1",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.9",
    "stylelint": "17.15.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
